{
  "_comment": "Secret detection for scan-secrets (pre-commit, CI) and the default secretPaths used by the read guard. Findings are reported by rule id and location only; the matched value is never printed. A line containing the allowMarker is skipped.",
  "allowMarker": "coding-plugin:allow-secret",
  "allowValues": ["AKIAIOSFODNN7EXAMPLE"],
  "secretFiles": [
    ".env",
    ".env.*",
    "!.env.example",
    "!.env.sample",
    "!.env.template",
    "!.env.dist",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/id_rsa*",
    "**/id_ecdsa*",
    "**/id_ed25519*",
    "!**/*.pub",
    "secrets/**"
  ],
  "patterns": [
    {"id": "aws-access-key-id", "regex": "\\b(?:AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}\\b"},
    {"id": "aws-secret-access-key", "regex": "(?i)aws_?secret_?access_?key\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{40}\\b"},
    {"id": "private-key", "regex": "-----BEGIN (?:[A-Z]+ )?PRIVATE KEY(?: BLOCK)?-----"},
    {"id": "github-token", "regex": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,}\\b"},
    {"id": "github-fine-grained-token", "regex": "\\bgithub_pat_[A-Za-z0-9_]{50,}\\b"},
    {"id": "gitlab-token", "regex": "\\bglpat-[A-Za-z0-9_-]{20,}\\b"},
    {"id": "slack-token", "regex": "\\bxox[abposr]-[A-Za-z0-9-]{10,}\\b"},
    {"id": "slack-webhook", "regex": "https://hooks\\.slack\\.com/services/T[A-Za-z0-9_]+/B[A-Za-z0-9_]+/[A-Za-z0-9_]+"},
    {"id": "stripe-live-key", "regex": "\\b(?:sk|rk)_live_[A-Za-z0-9]{20,}\\b"},
    {"id": "google-api-key", "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b"},
    {"id": "anthropic-api-key", "regex": "\\bsk-ant-[A-Za-z0-9_-]{20,}"},
    {"id": "openai-api-key", "regex": "\\bsk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{20,}T3BlbkFJ[A-Za-z0-9_-]{20,}"},
    {"id": "npm-token", "regex": "\\bnpm_[A-Za-z0-9]{36}\\b"}
  ]
}
