{
  "_comment": "Claude Code hook stdin payloads (fields per code.claude.com/docs/en/hooks). {repo} is replaced with the test repo path.",
  "pre_bash_dangerous": {
    "session_id": "sess-1", "transcript_path": "/tmp/transcript.jsonl", "cwd": "{repo}",
    "permission_mode": "default", "hook_event_name": "PreToolUse", "tool_name": "Bash",
    "tool_input": {"command": "rm -rf ~", "description": "Clean up"}, "tool_use_id": "toolu_01"
  },
  "pre_bash_safe": {
    "session_id": "sess-1", "transcript_path": "/tmp/transcript.jsonl", "cwd": "{repo}",
    "permission_mode": "default", "hook_event_name": "PreToolUse", "tool_name": "Bash",
    "tool_input": {"command": "ls -la", "description": "List files"}, "tool_use_id": "toolu_02"
  },
  "pre_edit_env": {
    "session_id": "sess-1", "transcript_path": "/tmp/transcript.jsonl", "cwd": "{repo}",
    "permission_mode": "acceptEdits", "hook_event_name": "PreToolUse", "tool_name": "Edit",
    "tool_input": {"file_path": "{repo}/.env", "old_string": "A=1", "new_string": "A=2"}, "tool_use_id": "toolu_03"
  },
  "pre_write_src": {
    "session_id": "sess-1", "transcript_path": "/tmp/transcript.jsonl", "cwd": "{repo}",
    "permission_mode": "default", "hook_event_name": "PreToolUse", "tool_name": "Write",
    "tool_input": {"file_path": "{repo}/src/app.py", "content": "print('hi')\n"}, "tool_use_id": "toolu_04"
  },
  "pre_notebook_secret": {
    "session_id": "sess-1", "transcript_path": "/tmp/transcript.jsonl", "cwd": "{repo}",
    "permission_mode": "default", "hook_event_name": "PreToolUse", "tool_name": "NotebookEdit",
    "tool_input": {"notebook_path": "{repo}/secrets/analysis.ipynb", "new_source": "x = 1"}, "tool_use_id": "toolu_05"
  },
  "pre_read_env": {
    "session_id": "sess-1", "transcript_path": "/tmp/transcript.jsonl", "cwd": "{repo}",
    "permission_mode": "default", "hook_event_name": "PreToolUse", "tool_name": "Read",
    "tool_input": {"file_path": "{repo}/.env"}, "tool_use_id": "toolu_06"
  },
  "pre_grep_ignored": {
    "session_id": "sess-1", "transcript_path": "/tmp/transcript.jsonl", "cwd": "{repo}",
    "permission_mode": "default", "hook_event_name": "PreToolUse", "tool_name": "Grep",
    "tool_input": {"pattern": "TODO"}, "tool_use_id": "toolu_07"
  },
  "post_edit_txt": {
    "session_id": "sess-1", "transcript_path": "/tmp/transcript.jsonl", "cwd": "{repo}",
    "permission_mode": "default", "hook_event_name": "PostToolUse", "tool_name": "Edit",
    "tool_input": {"file_path": "{repo}/notes.txt", "old_string": "a", "new_string": "b"},
    "tool_response": {"filePath": "{repo}/notes.txt", "success": true}, "tool_use_id": "toolu_08"
  },
  "stop_first": {
    "session_id": "sess-1", "transcript_path": "/tmp/transcript.jsonl", "cwd": "{repo}",
    "permission_mode": "default", "hook_event_name": "Stop", "stop_hook_active": false,
    "last_assistant_message": "Done."
  },
  "stop_continuing": {
    "session_id": "sess-1", "transcript_path": "/tmp/transcript.jsonl", "cwd": "{repo}",
    "permission_mode": "default", "hook_event_name": "Stop", "stop_hook_active": true,
    "last_assistant_message": "Fixed it."
  },
  "session_start": {
    "session_id": "sess-1", "transcript_path": "/tmp/transcript.jsonl", "cwd": "{repo}",
    "hook_event_name": "SessionStart", "source": "startup", "model": "claude-opus-5-5"
  }
}
