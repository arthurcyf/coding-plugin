#!/bin/sh
# coding-plugin pre-commit hook: secret scan + protected paths (+ checks if preCommitCheck).
# Installed by coding-plugin; enabled with `git config core.hooksPath .githooks`.
# Configure in .coding-plugin.json. Bypass deliberately: CODING_PLUGIN_DISABLE=<guard> or --no-verify.
root=$(git rev-parse --show-toplevel) || exit 0
core="$root/.coding-plugin/bin/coding_plugin.py"
if [ ! -f "$core" ]; then
  echo "coding-plugin: $core not found; skipping pre-commit checks" >&2
  exit 0
fi
case "$(uname -s 2>/dev/null)" in
  MINGW* | MSYS* | CYGWIN*) candidates="py python python3" ;;  # Windows: py launcher first
  *) candidates="python3 python" ;;
esac
for py in $candidates; do
  [ "$py" = py ] && set -- -3 || set --
  if command -v "$py" >/dev/null 2>&1 && "$py" "$@" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    exec "$py" "$@" "$core" pre-commit
  fi
done
echo "coding-plugin: Python 3.9+ not found; skipping pre-commit checks" >&2
exit 0
